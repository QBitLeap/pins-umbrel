diff --git a/packages/indexer/read-safety.test.ts b/packages/indexer/read-safety.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/indexer/read-safety.test.ts
@@ -0,0 +1,47 @@
+// Local read-only indexer acceptance; synthetic bytes, no keys/RPC/signatures.
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { Store } from './store.ts';
+import { toChainBlock } from './chain.ts';
+import { buildEnvelope, parseEnvelopes, pointerField, metadataField, concatBytes, pushBytes, MARKER } from '../inscriber/script.ts';
+
+const TX='11'.repeat(32);
+test('metadata chunks and an empty zero pointer preserve exact bytes',()=>{
+ const metadata=new Uint8Array(1100).fill(42),body=new Uint8Array([1,2]);
+ const parsed=parseEnvelopes(buildEnvelope([pointerField(0n),metadataField(metadata)],body))[0];
+ assert.deepEqual(parsed.body,body);assert.deepEqual(parsed.fields.find(f=>f.tag===5)?.value,metadata);
+ assert.equal(parsed.fields.find(f=>f.tag===2)?.value.length,0);assert.deepEqual(parsed.flags,[]);
+});
+test('unknown multibyte even tags make content opaque',()=>{
+ const leaf=concatBytes([new Uint8Array([0,0x63]),pushBytes(MARKER),pushBytes(new Uint8Array([0x80,1])),pushBytes(new Uint8Array([1])),new Uint8Array([0,0x68])]);
+ assert.ok(parseEnvelopes(leaf)[0].flags.includes('opaque'));
+});
+test('same-block hydration promotes only equal cached output values and reorg works',()=>{
+ const dir=mkdtempSync(join(tmpdir(),'pins-read-'));const path=join(dir,'index.sqlite');const store=new Store(path,{network:'testnet4'});
+ const block={height:0,hash:'aa'.repeat(32),subsidy:50n,txs:[{txid:TX,inputs:[{coinbase:true,value:0n}],outputs:[{value:50n,script:new Uint8Array([0x51])}]}]};
+ try {
+  store.saveOutput(TX,0,50n);store.commit(block);assert.equal(store.tip()?.height,0);store.disconnect();assert.equal(store.tip(),null);
+  store.saveOutput(TX,0,49n);assert.throws(()=>store.commit(block),/conflicts/);assert.equal(store.tip(),null);assert.equal(store.indexer.lastUndo(),undefined);
+ }finally{store.close();rmSync(dir,{recursive:true,force:true});}
+});
+test('a database cannot be reopened on another network',()=>{
+ const dir=mkdtempSync(join(tmpdir(),'pins-read-'));const path=join(dir,'index.sqlite');
+ try{new Store(path,{network:'testnet4'}).close();assert.throws(()=>new Store(path,{network:'mainnet'}),/network binding/);}finally{rmSync(dir,{recursive:true,force:true});}
+});
+function raw(coinbase:boolean,value:bigint){
+ const val=Buffer.alloc(8);val.writeBigUInt64LE(value);
+ return Buffer.concat([Buffer.from('0100000001','hex'),coinbase?Buffer.alloc(32):Buffer.from(TX,'hex'),Buffer.from(coinbase?'ffffffff':'00000000','hex'),Buffer.from('00ffffffff01','hex'),val,Buffer.from('015100000000','hex')]).toString('hex');
+}
+test('actual subsidy survives an underclaimed coinbase; spent type and leaf version constrain envelopes',()=>{
+ const envelope=buildEnvelope([],new Uint8Array([9]));
+ const spend={txid:'22'.repeat(32),hex:raw(false,40n),vin:[{prevout:{scriptPubKey:{hex:'5220'+'33'.repeat(32)}},txinwitness:['01',Buffer.from(envelope).toString('hex'),'c0']}],vout:[{scriptPubKey:{hex:'51'}}]};
+ const block={hash:'aa'.repeat(32),height:1,tx:[{txid:TX,hex:raw(true,45n),vin:[{coinbase:'00'}],vout:[{scriptPubKey:{hex:'51'}}]},spend]};
+ assert.throws(()=>toChainBlock(block,()=>50n),/subsidy/);
+ const valid=toChainBlock(block,()=>50n,50n);assert.equal(valid.subsidy,50n);assert.deepEqual(valid.txs[1].inputs[0].leafScript,envelope);
+ spend.vin[0].txinwitness[2]='c2';assert.equal(toChainBlock(block,()=>50n,50n).txs[1].inputs[0].leafScript,undefined);
+ spend.vin[0].prevout.scriptPubKey.hex='51';spend.vin[0].txinwitness[2]='c0';assert.equal(toChainBlock(block,()=>50n,50n).txs[1].inputs[0].leafScript,undefined);
+ spend.vin[0].prevout.scriptPubKey.hex='5220'+'33'.repeat(32);spend.vin[0].txinwitness=[];assert.throws(()=>toChainBlock(block,()=>50n,50n),/Missing P2MR witness/);
+});
